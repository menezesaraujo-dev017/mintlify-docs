{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Sync Applications — Aprenda a configurar e utilizar nosso bot",
  "colors": {
    "primary": "#5c5ef0",
    "light": "#7476F2",
    "dark": "#4547D9"
  },
  "favicon": {
    "light": "/images/1000641421.png",
    "dark": "/images/1000641421.png"
  },
  "navigation": {
    "global": {
      "anchors": [
        {
          "anchor": "Documentation",
          "href": "https://mintlify.com/docs",
          "icon": "book-open-cover"
        },
        {
          "anchor": "Blog",
          "href": "https://mintlify.com/blog",
          "icon": "newspaper"
        }
      ]
    },
    "groups": [
      {
        "group": "V1",
        "icon": "sitemap",
        "pages": []
      }
    ]
  },
  "logo": {
    "light": "/images/1000641421.png",
    "dark": "/images/1000641421.png",
    "href": "https://syncapps.com.br"
  },
  "navbar": {
    "links": [
      {
        "href": "https://syncapps.com.br/plans",
        "label": "Planos"
      },
      {
        "href": "https://syncapps.com.br/terms",
        "label": "Termos"
      },
      {
        "href": "https://syncapps.com.br/login",
        "label": "Login"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://app.mintlify.com"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ]
  },
  "footer": {
    "socials": {
      "github": "https://github.com/menezesaraujo-dev017",
      "website": "https://syncapps.com.br"
    }
  },
  "description": "Aprenda a configurar, gerenciar e utilizar todos os recursos do nosso bot de forma simples e rápida.",
  "icons": {
    "library": "lucide"
  },
  "background": {
    "decoration": "gradient"
  },
  "fonts": {
    "family": "Source Sans Pro"
  },
  "banner": {
    "content": "Teste",
    "dismissible": true,
    "type": "warning",
    "color": {
      "light": "#FFD93D",
      "dark": "#E0A800"
    }
  },
  "thumbnails": {
    "background": "/images/1000641421.png"
  }
